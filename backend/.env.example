# Copy to .env and change every value before going public.
POSTGRES_PASSWORD=change-this-db-password
# Must match the "Server key" typed in the app settings.
NAKAMA_SERVER_KEY=defaultkey
NAKAMA_CONSOLE_USER=admin
NAKAMA_CONSOLE_PASSWORD=change-this-admin-password
# Game servers per experience: "id=host:port". An empty host means
# "the same host as this account server". Default matches docker-compose.
GAME_SERVERS=island=:7777,lava_rising=:7778,color_drop=:7779,obby_rush=:7780

# Moderators: comma-separated usernames that can review reports and
# remove community games from the app (SETTINGS > Moderation).
ADMIN_USERS=

# Secret shared by the account server and the game servers. When set,
# game servers only accept signed-in players (banned players can't join)
# and kick players a moderator kicks. Use a long random string.
JOIN_SECRET=

# Key game servers use to ask the account server who to kick.
NAKAMA_HTTP_KEY=change-this-http-key
